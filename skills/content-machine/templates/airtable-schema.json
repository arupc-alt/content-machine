    },
    {
      "table": "content_items",
      "field": {
        "name": "Feedback Log",
        "type": "multipleRecordLinks",
        "options": {
          "linkedTableKey": "feedback_log"
        }
      },
      "renameInverseTo": "Related Item"
    },
    {
      "table": "team",
      "field": {
        "name": "Heartbeat Late",
        "type": "formula",
        "options": {
          "formula": "IF(OR({Paused}, AND({Limit Reached}, OR({API Month}=DATETIME_FORMAT(NOW(), 'YYYY-MM'), {API Month}=DATETIME_FORMAT(DATEADD(NOW(), -4, 'days'), 'YYYY-MM')))), 0, IF(OR(IF({Last Run Orchestrator}, DATETIME_DIFF(NOW(), {Last Run Orchestrator}, 'hours') > IF(AND({Days}='Weekdays', OR(WEEKDAY(NOW())=5, WEEKDAY(NOW())=6, WEEKDAY(NOW())=0, WEEKDAY(NOW())=1)), 78, 30), 0), IF({Last Run Brief}, DATETIME_DIFF(NOW(), {Last Run Brief}, 'hours') > IF(AND({Days}='Weekdays', OR(WEEKDAY(NOW())=5, WEEKDAY(NOW())=6, WEEKDAY(NOW())=0, WEEKDAY(NOW())=1)), 78, 30), 0), IF({Last Run Blog Writer}, DATETIME_DIFF(NOW(), {Last Run Blog Writer}, 'hours') > IF(AND({Days}='Weekdays', OR(WEEKDAY(NOW())=5, WEEKDAY(NOW())=6, WEEKDAY(NOW())=0, WEEKDAY(NOW())=1)), 78, 30), 0)), 1, 0))"
        }
      },
      "note": "1 means an agent has missed a full run day: 30 hours, or 78 hours from Friday to Monday (UTC) in Weekdays mode, so a weekend never counts in any time zone. Paused never counts, nor does Limit Reached during the month it was reached or the first 4 days (UTC) of the next month, until the new month's first round turns it off, and a blank Last Run never counts."
    }
  ],
  "automations": [
    {
      "key": "heartbeat",
      "name": "Content Machine: heartbeat alert",
      "always": true,
      "trigger": "Team row where Heartbeat Late = 1",
      "actions": [
        "sendEmail to the Schedule Host and every Active Approver in Members (email only; the heartbeat never posts in Slack)"
      ]
    },
    {
      "key": "bot",
      "name": "Content Machine: notify reviewers ([Product])",
      "always": true,
      "purpose": "The second delivery path, one bot per product: every waiting update and every posted question for that product also goes out from its bot, next to the agent's own post (shared/slack.md, Who posts, and where). Its ID and Bot Status are in the product's Settings row",
      "skippedOnlyIf": "the bot can't be built (Slack can't be connected inside Airtable, the session has no Airtable automation tools, or a step still fails after one fix and retry), or the person declines it after hearing the risk (modes/setup.md, Step 7, Going without the bot)",
      "trigger": "Content Items row whose Product is this product, and whose Status is any of Awaiting Brief Approval, QA Passed - Awaiting Publish Review, Escalated - Needs Human Input, or whose Open Question is not empty",
      "actions": [
        "sendToSlack, username 'Content Machine', to the product's channel plus up to 9 of the product's approvers by Slack ID: first one branch for a question (Open Question not empty), then two branches per status, by whether Slack Thread Link is empty (see shared/slack.md, The Airtable bot)"
      ]
    }
  ]
