{
  "schemaVersion": 3,
  "baseNamePattern": "[Company] Content Machine",
  "notes": [
    "This file is passed to create_base almost as is. Setup creates the 7 tables below in one call, then adds every field listed under addAfterCreate (link fields and formulas need the tables to exist first).",
    "It holds no records and no IDs. After the base exists, setup reads it back and saves every table, field, and choice ID in the Team row's Schema Map field.",
    "Field names are fixed. Agents use the saved IDs, so a person renaming a field in Airtable breaks nothing."
  ],
  "tables": [
    {
      "key": "content_items",
      "name": "Content Items",
      "description": "One row per piece of content moving through the pipeline. The live tracker every agent reads and writes.",
      "fields": [
        {
          "name": "Item ID",
          "type": "singleLineText",
          "description": "Item ID Prefix plus Seq, zero-padded to 4 digits. Written by the agent that creates the row, right after it reads back Seq."
        },
        {
          "name": "Seq",
          "type": "autoNumber",
          "description": "The number part of Item ID. Airtable assigns it, so two runs can never get the same number."
        },
        {
          "name": "Product",
          "type": "singleLineText",
          "description": "Matches the Product field of one Settings row."
        },
        {
          "name": "Trigger Type",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "Topic"
              },
              {
                "name": "Keyword"
              }
            ]
          }
        },
        {
          "name": "Input",
          "type": "multilineText",
          "description": "The topic or keyword exactly as the person gave it, plus any context they added."
        },
        {
          "name": "Working Title",
          "type": "singleLineText",
          "description": "The piece's working title. Written by the Brief Agent (or the Blog Writer for a pasted brief). Before a title exists, messages use Input."
        },
        {
          "name": "Primary Keyword",
          "type": "singleLineText"
        },
        {
          "name": "Secondary Keywords",
          "type": "multilineText"
        },
        {
          "name": "Format Skeleton",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "Comparison/Alternatives"
              },
              {
                "name": "Versus/Head-to-Head"
              },
              {
                "name": "Listicle/Examples"
              },
              {
                "name": "How-to/Guide"
              }
            ]
          }
        },
        {
          "name": "Status",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "Topic Requested",
                "color": "grayLight2"
              },
              {
                "name": "Brief In Progress",
                "color": "blueLight2"
              },
              {
                "name": "Awaiting Brief Approval",
                "color": "yellowLight2"
              },
              {
                "name": "Brief Approved",
                "color": "greenLight1"
              },
              {
                "name": "Writing In Progress",
                "color": "blueLight1"
              },
              {
                "name": "In QA",
                "color": "purpleLight2"
              },
              {
                "name": "QA Passed - Awaiting Publish Review",
                "color": "tealLight2"
              },
              {
                "name": "Needs Rework",
                "color": "orangeLight2"
              },
              {
                "name": "Rework In Progress",
                "color": "orangeDark1"
              },
              {
                "name": "Escalated - Needs Human Input",
                "color": "redBright"
              },
              {
                "name": "Published",
                "color": "greenBright"
              },
              {
                "name": "Rejected",
                "color": "grayDark1"
              }
            ]
          }
        },
        {
          "name": "Doc Home",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "Drive"
              },
              {
                "name": "Notion"
              }
            ]
          },
          "description": "Where this piece's documents live. Set once when the row is created and never changed."
        },
        {
          "name": "Brief Doc Link",
          "type": "url"
        },
        {
          "name": "Blog Doc Link",
          "type": "url"
        },
        {
          "name": "QA Report Link",
          "type": "url"
        },
        {
          "name": "QA Score",
          "type": "singleLineText",
          "description": "Passed over total, like 21/23. Base dimensions only. Product rules go in Product Rules Result."
        },
        {
          "name": "Product Rules Result",
          "type": "singleLineText",
          "description": "Like 11 of 12."
        },
        {
          "name": "Brief Rework Count",
          "type": "number",
          "options": {
            "precision": 0
          },
          "description": "Brief-stage rework passes. Blank means 0."
        },
        {
          "name": "Draft Rework Count",
          "type": "number",
          "options": {
            "precision": 0
          },
          "description": "Draft-stage rework passes. Blank means 0."
        },
        {
          "name": "QA Round",
          "type": "number",
          "options": {
            "precision": 0
          },
          "description": "The QA round the Blog Writer last saved. Used to resume a run that died."
        },
        {
          "name": "Slack Thread Link",
          "type": "url",
          "description": "Link to the latest approval, verdict, or escalation post for this piece."
        },
        {
          "name": "Assigned Reviewer",
          "type": "singleLineText"
        },
        {
          "name": "Owner",
          "type": "email",
          "description": "Who owns the piece. Blank gets the host when an agent claims it."
        },
        {
          "name": "Priority",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "High"
              },
              {
                "name": "Normal"
              },
              {
                "name": "Low"
              }
            ]
          },
          "description": "Set by people. High goes first within its queue step."
        },
        {
          "name": "Claimed By",
          "type": "singleLineText",
          "description": "Which mode and run holds this row, like 'Brief Agent, scheduled', 'Blog Writer, [person]', or 'Blog Writer (QA in-session)'."
        },
        {
          "name": "Claimed At",
          "type": "dateTime",
          "options": {
            "dateFormat": {
              "name": "iso"
            },
            "timeFormat": {
              "name": "24hour"
            },
            "timeZone": "utc"
          }
        },
        {
          "name": "Claim Token",
          "type": "singleLineText",
          "description": "A random token the claiming run writes and then re-reads. Only the run whose token is there goes ahead."
        },
        {
          "name": "Last Saved Step",
          "type": "singleLineText",
          "description": "Where the claiming run got to. One of the values listed in shared/airtable.md (Last Saved Step). The next run resumes from here."
        },
        {
          "name": "Stall Count",
          "type": "number",
          "options": {
            "precision": 0
          },
          "description": "How many times this row stalled. At 2 it is escalated."
        },
        {
          "name": "Human Feedback",
          "type": "multilineText",
          "description": "Written only by the Orchestrator: each reviewer's feedback in their own words, with its source link and time."
        },
        {
          "name": "Agent Notes",
          "type": "multilineText",
          "description": "The pipeline's working notes for this piece: writer notes, QA issues lists, send-back notes, post history. Only the agent holding the claim adds to it, always at the end, never overwriting. Each block starts with '[agent] [ISO time]:'."
        },
        {
          "name": "Duplicate Decision",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "Pending"
              },
              {
                "name": "Go"
              },
              {
                "name": "Drop"
              }
            ]
          }
        },
        {
          "name": "Overlap With",
          "type": "multilineText",
          "description": "Item IDs or live URLs this piece may duplicate."
        },
        {
          "name": "Open Question",
          "type": "multilineText",
          "description": "A question a run asked before going on, with its Slack link (G25). Rows with this filled in are skipped until the Orchestrator records an answer and clears it, or drops the piece."
        },
        {
          "name": "Health Flag",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "OK"
              },
              {
                "name": "Needs Fix"
              }
            ]
          }
        },
        {
          "name": "Reference Version",
          "type": "singleLineText"
        },
        {
          "name": "Rules Loaded",
          "type": "singleLineText",
          "description": "Like 'base 48, product 12, learned 3, version 4'."
        },
        {
          "name": "Freshness Flags",
          "type": "multilineText"
        },
        {
          "name": "Recheck Due",
          "type": "date",
          "options": {
            "dateFormat": {
              "name": "iso"
            }
          },
          "description": "When a flagged fact (a price, a limit) must be checked again."
        },
        {
          "name": "Live URL",
          "type": "url"
        },
        {
          "name": "Published At",
          "type": "dateTime",
          "options": {
            "dateFormat": {
              "name": "iso"
            },
            "timeFormat": {
              "name": "24hour"
            },
            "timeZone": "utc"
          }
        },
        {
          "name": "Created At",
          "type": "dateTime",
          "options": {
            "dateFormat": {
              "name": "iso"
            },
            "timeFormat": {
              "name": "24hour"
            },
            "timeZone": "utc"
          }
        },
        {
          "name": "Last Updated At",
          "type": "dateTime",
          "options": {
            "dateFormat": {
              "name": "iso"
            },
            "timeFormat": {
              "name": "24hour"
            },
            "timeZone": "utc"
          }
        },
        {
          "name": "Notes",
          "type": "multilineText",
          "description": "For people. Agents may add one short run line here, but never read it back."
        }
      ]
    },
    {
      "key": "settings",
      "name": "Settings",
      "description": "One row per product. Each setting has its own field.",
      "fields": [
        {
          "name": "Product",
          "type": "singleLineText"
        },
        {
          "name": "Company",
          "type": "singleLineText"
        },
        {
          "name": "Website URL",
          "type": "url"
        },
        {
          "name": "Docs URL",
          "type": "url"
        },
        {
          "name": "Item ID Prefix",
          "type": "singleLineText",
          "description": "Like ACME-AR-. Ends with a hyphen."
        },
        {
          "name": "Slack Channel Name",
          "type": "singleLineText"
        },
        {
          "name": "Slack Channel ID",
          "type": "singleLineText"
        },
        {
          "name": "Doc Home",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "Drive"
              },
              {
                "name": "Notion"
              }
            ]
          }
        },
        {
          "name": "Drive Folder",
          "type": "url"
        },
        {
          "name": "Notion Home",
          "type": "url"
        },
        {
          "name": "Doc Sharing",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "Notion web link"
              },
              {
                "name": "Notion guests"
              },
              {
                "name": "Drive commenters"
              }
            ]
          }
        },
        {
          "name": "Language",
          "type": "singleLineText"
        },
        {
          "name": "Spelling",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "US"
              },
              {
                "name": "UK"
              }
            ]
          }
        },
        {
          "name": "Bot Status",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "On"
              },
              {
                "name": "Off"
              },
              {
                "name": "Failed test"
              }
            ]
          },
          "description": "This product's notification bot (shared/slack.md, The Airtable bot): On, Off, or Failed test. Setup sets it after the bot's test."
        },
        {
          "name": "Bot Automation ID",
          "type": "singleLineText",
          "description": "The automation ID of this product's bot, \"Content Machine: notify reviewers ([Product])\"."
        },
        {
          "name": "Set Up On",
          "type": "date",
          "options": {
            "dateFormat": {
              "name": "iso"
            }
          }
        },
        {
          "name": "Notes",
          "type": "multilineText",
          "description": "History, for people only. Never read as setup."
        }
      ]
    },
    {
      "key": "team",
      "name": "Team",
      "description": "Exactly one row. Values that are the same for the whole base.",
      "fields": [
